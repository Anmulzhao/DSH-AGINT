{
  "$schema": "../../docs/plugins/PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-skill-autocreate",
  "version": "0.3.5",
  "description": "P0-1 技能自动创建机制 v0.3.5（Sprint 14 检测层 + Sprint 15 评估层 + Sprint 16 发布层 + Sprint 17 跨会话聚合）：聚合 tool-stats → 模式检测（次数≥N 且 successRate≥min_pattern_success_rate 才成候选）→ 候选生成 → D-QAF 三阶段评估（Phase 1 = quality-static 安全/格式四族 + semantics 语义准入：负面断言/环境故障无解法/瞬时错误/失败包装成最佳实践/会话产物式命名）→ 三道门发布 → 14 天观察期。**Sprint 17 新增**：跨会话聚合三档模式 off/shadow/primary（默认 off 完全兼容 v0.3.4），13.5 天 / 9088 条回放验证跨过 min_occurrence_count≥3 的模式数 11 → 21（+91%）。独占 agint_skill_autocreate 存储域（5 表），自我评估禁止（§9.4）。",
  "main": "lib/index.js",
  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 1,
    "stability": "experimental"
  },
  "spec": {
    "cordis": {
      "inject": [
        "storageDomain"
      ],
      "optionalInject": [
        "agint.eventBus"
      ],
      "provides": [
        "agint.skillAutocreate"
      ],
      "events": [
        "skill-autocreate.pattern-detected",
        "skill-autocreate.candidate-created",
        "skill-autocreate.phase1-passed",
        "skill-autocreate.phase1-rejected",
        "skill-autocreate.phase2-passed",
        "skill-autocreate.phase2-rejected",
        "skill-autocreate.phase3-passed",
        "skill-autocreate.phase3-rejected",
        "skill-autocreate.released",
        "skill-autocreate.rolled-back",
        "skill-autocreate.budget-exceeded",
        "skill-autocreate.release-held",
        "skill-autocreate.release-stable"
      ],
      "tools": [
        "autocreate_list_patterns",
        "autocreate_list_candidates",
        "autocreate_get_candidate",
        "autocreate_trigger_eval",
        "autocreate_stats",
        "autocreate_release",
        "autocreate_rollback",
        "autocreate_list_releases",
        "autocreate_modify"
      ]
    },
    "storage": {
      "domains": [
        "agint_skill_autocreate"
      ],
      "schemaVersion": 1,
      "atomic": "json"
    },
    "dependencies": {
      "agint-tool-stats": ">=0.1.0",
      "agint-event-bus": ">=0.7.0",
      "zod": "^3.0.0"
    },
    "mountOrder": 25,
    "permissions": {
      "env": [
        "DSH_HOME"
      ],
      "fs": [
        "read:storages",
        "write:storages",
        "read:agent-presets",
        "write:agent-presets"
      ],
      "network": [],
      "shell": false
    },
    "lifecycle": {
      "intervals": "none",
      "listeners": "none",
      "tools": "none",
      "shutdown": "graceful"
    },
    "tests": {
      "entry": "test/smoke.mjs",
      "command": "node --test \"test/*.test.mjs\" test/smoke.mjs",
      "expectedExit": 0
    },
    "docs": {
      "readme": "README.md",
      "serviceDocs": {
        "agint.skillAutocreate": "技能自动创建全链路：detect / triggerEval / release（三道门+原子挂载）/ releaseQueue（cron）/ rollback（归档+冷却）/ observe（观察期）/ listReleases / listPatterns / listCandidates / getCandidate / rejectCandidate / modifyCandidate / stats / pause / resume / config"
      }
    },
    "changelog": "CHANGELOG.md",
    "compatSince": "0.1.0"
  }
}
