{
  "$schema": "../../docs/plugins/PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-skill-autocreate",
  "version": "0.3.1",
  "description": "P0-1 技能自动创建机制 v0.3.0（Sprint 14 检测层 + Sprint 15 评估层 + Sprint 16 发布层）：聚合 tool-stats → 模式检测 → 候选生成 → D-QAF 三阶段评估 → 三道门发布（总开关/policy 门/周预算；人工确认窗默认关）→ 14 天观察期（0 调用三重确认自动回滚，只归档不删除+30 天冷却）。独占 agint_skill_autocreate 存储域（5 表），自我评估禁止（§9.4）。",
  "main": "lib/index.js",
  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 1,
    "stability": "experimental"
  },
  "spec": {
    "cordis": {
      "inject": [
        "storageDomain"
      ],
      "optionalInject": [
        "agint.eventBus"
      ],
      "provides": [
        "agint.skillAutocreate"
      ],
      "events": [
        "skill-autocreate.pattern-detected",
        "skill-autocreate.candidate-created",
        "skill-autocreate.phase1-passed",
        "skill-autocreate.phase1-rejected",
        "skill-autocreate.phase2-passed",
        "skill-autocreate.phase2-rejected",
        "skill-autocreate.phase3-passed",
        "skill-autocreate.phase3-rejected",
        "skill-autocreate.released",
        "skill-autocreate.rolled-back",
        "skill-autocreate.budget-exceeded",
        "skill-autocreate.release-held",
        "skill-autocreate.release-stable"
      ],
      "tools": [
        "autocreate_list_patterns",
        "autocreate_list_candidates",
        "autocreate_get_candidate",
        "autocreate_trigger_eval",
        "autocreate_stats",
        "autocreate_release",
        "autocreate_rollback",
        "autocreate_list_releases",
        "autocreate_modify"
      ]
    },
    "storage": {
      "domains": [
        "agint_skill_autocreate"
      ],
      "schemaVersion": 1,
      "atomic": "json"
    },
    "dependencies": {
      "agint-tool-stats": ">=0.1.0",
      "agint-event-bus": ">=0.7.0",
      "zod": "^3.0.0"
    },
    "mountOrder": 25,
    "permissions": {
      "env": [
        "DSH_HOME"
      ],
      "fs": [
        "read:storages",
        "write:storages",
        "read:agent-presets",
        "write:agent-presets"
      ],
      "network": [],
      "shell": false
    },
    "lifecycle": {
      "intervals": "none",
      "listeners": "none",
      "tools": "none",
      "shutdown": "graceful"
    },
    "tests": {
      "entry": "test/smoke.mjs",
      "command": "node --test \"test/*.test.mjs\" test/smoke.mjs",
      "expectedExit": 0
    },
    "docs": {
      "readme": "README.md",
      "serviceDocs": {
        "agint.skillAutocreate": "技能自动创建全链路：detect / triggerEval / release（三道门+原子挂载）/ releaseQueue（cron）/ rollback（归档+冷却）/ observe（观察期）/ listReleases / listPatterns / listCandidates / getCandidate / rejectCandidate / modifyCandidate / stats / pause / resume / config"
      }
    },
    "changelog": "CHANGELOG.md",
    "compatSince": "0.1.0"
  }
}
