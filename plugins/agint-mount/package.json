{
  "name": "agint-mount",
  "version": "0.6.5",
  "description": "AGINT 动态插件挂载编排器 v0.6.5：PREPARE→SMOKE→ACTIVATE 三段式事务（4 态状态机 PREPARED→INSTALLED→RESTART_REQUESTED→ACTIVATED），两段式 commit（HMR 成功前 atomic backup 永不清），3 Service（mount.request / mount.status / mount.rollback），FROZEN MountResult schema，独占 agint_mount 存储域。Sprint 11 收口 / 设计稿 Sprint11 §4.1。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/orchestrator.js": "./lib/orchestrator.js",
    "./lib/health-probe.js": "./lib/health-probe.js",
    "./lib/rollback.js": "./lib/rollback.js",
    "./lib/storage.js": "./lib/storage.js",
    "./lib/schemas.js": "./lib/schemas.js",
    "./lib/paths.js": "./lib/paths.js",
    "./lib/patch.js": "./lib/patch.js",
    "./schemas/mount-result.schema.yaml": "./schemas/mount-result.schema.yaml"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "node test/smoke.mjs",
    "smoke": "node test/smoke.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "agint",
    "mount",
    "three-phase-commit",
    "two-phase-commit",
    "hmr",
    "sprint-11",
    "p6"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": "*",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
