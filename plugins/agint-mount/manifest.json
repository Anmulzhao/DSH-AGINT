{
  "$schema": "../../docs/plugins/PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-mount",
  "version": "0.6.5",
  "description": "AGINT 动态插件挂载编排器 v0.6.5：PREPARE→SMOKE→ACTIVATE 三段式事务（4 态状态机 PREPARED→INSTALLED→RESTART_REQUESTED→ACTIVATED），两段式 commit（HMR 成功前 atomic backup 永不清），3 Service（mount.request / mount.status / mount.rollback），FROZEN MountResult schema，独占 agint_mount 存储域。Sprint 11 收口 / 设计稿 Sprint11 §4.1。",
  "main": "lib/index.js",

  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 1,
    "stability": "experimental"
  },

  "spec": {
    "cordis": {
      "inject": [
        "storageDomain",
        "agint.qualitySandbox"
      ],
      "optionalInject": [
        "agint.evolution",
        "agint.population.ingest"
      ],
      "provides": [
        "agint.mount.request",
        "agint.mount.status",
        "agint.mount.rollback"
      ],
      "events": [
        "tools/post-execute"
      ],
      "tools": []
    },

    "storage": {
      "domains": ["agint_mount"],
      "schemaVersion": 1,
      "atomic": "json"
    },

    "dependencies": {
      "@deepseek-ai/dsh-storage-domain": ">=0.1.0",
      "agint-quality-sandbox": ">=0.6.3",
      "agint-population": ">=0.6.2",
      "agint-evolution-memory": ">=0.3.0",
      "zod": "^3.0.0"
    },
    "mountOrder": 40,

    "permissions": {
      "env": ["DSH_HOME", "AGINT_HOME"],
      "fs": [
        "read:storages",
        "write:storages",
        "read:plugins",
        "write:plugins/.staging"
      ],
      "network": ["loopback"],
      "shell": false
    },

    "lifecycle": {
      "intervals": "must-dispose",
      "listeners": "must-dispose",
      "tools": "must-dispose",
      "shutdown": "graceful"
    },

    "tests": {
      "entry": "test/smoke.mjs",
      "command": "node test/smoke.mjs",
      "expectedExit": 0
    },

    "docs": {
      "readme": "README.md",
      "serviceDocs": {
        "agint.mount.request": "受理挂载请求（proposal + verdict）→ 三段式事务编排 → MountTicket；沙箱不可用时降级 PENDING_REVIEW",
        "agint.mount.status": "查询 ticket 当前阶段（PREPARED/INSTALLED/RESTART_REQUESTED/ACTIVATED/HEALTHY/DISABLED/ROLLED_BACK）+ 探针历史",
        "agint.mount.rollback": "显式回滚（人类否决权入口）；从 fromPhase 倒序执行 PREPARE/SMOKE/ACTIVATE 清理"
      }
    },

    "changelog": "CHANGELOG.md",
    "compatSince": "0.6.5"
  }
}
