{
  "$schema": "../../docs/plugins/PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-curator",
  "version": "0.2.2",
  "description": "P0-2 技能策展人 v0.2.2：在 v0.2.0 基础策展（周聚合使用数据 → 状态机检测陈旧 → 保护 → 归档可恢复）+ v0.2.1 多根扫描/孤儿清扫/lastRunAt 落盘之上，修「多根只改了扫描侧」的漏项 —— 归档/恢复的路径计算改为按技能所属根定位（账本新增 rootDir/dirName 字段，扫描时写、归档时用），多根部署下不再因 path.join(数组) 抛错而静默失效。存储域 agint_curator schemaVersion 保持 2（两个新字段可选且有默认值，双向兼容；bump 需 compatibleVersions 且会让回滚路径 version-mismatch）。不做 consolidate/prune（Sprint 16，显式抛未实现）。",
  "main": "lib/index.js",
  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 1,
    "stability": "experimental"
  },
  "spec": {
    "cordis": {
      "inject": [
        "storageDomain"
      ],
      "optionalInject": [
        "agint.eventBus",
        "agint.cron"
      ],
      "provides": [
        "agint.curator"
      ],
      "events": [
        "curator.skill-staled",
        "curator.skill-archived",
        "curator.skill-reactivated",
        "curator.skill-pinned",
        "curator.run-completed",
        "curator.overlap-detected",
        "curator.quality-declining",
        "curator.consolidate-proposed"
      ],
      "tools": [
        "curator_list",
        "curator_status",
        "curator_stats",
        "curator_get_skill",
        "curator_pin",
        "curator_unpin",
        "curator_archive",
        "curator_unarchive",
        "curator_run_now",
        "curator_dry_run",
        "curator_list_overlaps",
        "curator_list_declining",
        "curator_get_report"
      ]
    },
    "storage": {
      "domains": [
        "agint_curator"
      ],
      "schemaVersion": 2,
      "atomic": "json"
    },
    "dependencies": {
      "agint-tool-stats": ">=0.1.0",
      "agint-event-bus": ">=0.7.0",
      "agint-cron": ">=0.7.0",
      "zod": "^3.0.0"
    },
    "mountOrder": 26,
    "permissions": {
      "env": [
        "DSH_HOME"
      ],
      "fs": [
        "read:storages",
        "write:storages",
        "read:presets",
        "write:presets"
      ],
      "network": [],
      "shell": false
    },
    "lifecycle": {
      "intervals": "none",
      "listeners": "none",
      "tools": "none",
      "shutdown": "graceful"
    },
    "tests": {
      "entry": "test/smoke.mjs",
      "command": "node --test \"test/*.test.mjs\" test/smoke.mjs",
      "expectedExit": 0
    },
    "docs": {
      "readme": "README.md",
      "serviceDocs": {
        "agint.curator": "技能策展：run/dryRun（同一条计算路径）/ listSkills / getSkill / pin / unpin / archive / unarchive / stats / getReport / pause / resume / config / listOverlaps / listDeclining；consolidate / prune 由 Sprint 16 接力（显式抛未实现）"
      }
    },
    "changelog": "CHANGELOG.md",
    "compatSince": "0.1.0"
  }
}
