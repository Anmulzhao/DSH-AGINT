{
  "$schema": "../../docs/plugins/PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-trajectory",
  "version": "0.1.0",
  "description": "P2-1 进化轨迹记录（训练数据层）：把 task/dream/eval/evolution/subagent 五类执行记为结构化轨迹，成功失败分离存储，ShareGPT+JSONL 双格式导出（离线分析与未来微调原料）。治理六件套：采样 / 脱敏 / 截断 / 预算 / prune / 熔断；count-only 标定期为切 live 的硬门禁（不变量 #5）。存储域 agint_trajectory schemaVersion 1。不注册 model-visible 工具（观察层，Service 面给 P2-2 与周报消费）。轨迹数据不进任何在线决策。",
  "main": "lib/index.js",
  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 1,
    "stability": "experimental"
  },
  "spec": {
    "cordis": {
      "inject": [
        "storageDomain"
      ],
      "optionalInject": [
        "agint.eventBus",
        "agint.metrics",
        "agint.toolStats"
      ],
      "provides": [
        "agint.trajectory"
      ],
      "events": [
        "trajectory.recorded",
        "trajectory.pruned",
        "trajectory.budget-exhausted"
      ],
      "tools": [],
      "subscribes": [
        "dream.completed",
        "evolution.proposed",
        "evolution.evaluated",
        "diagnosis.completed",
        "evo-orch.task-started",
        "evo-orch.task-completed"
      ]
    },
    "storage": {
      "domains": [
        "agint_trajectory"
      ],
      "schemaVersion": 1,
      "atomic": "json"
    },
    "dependencies": {
      "agint-event-bus": ">=0.7.0",
      "zod": "^3.0.0"
    },
    "mountOrder": 29,
    "permissions": {
      "env": [
        "DSH_HOME"
      ],
      "fs": [
        "read:storages",
        "write:storages",
        "write:trajectories"
      ],
      "network": [],
      "shell": false
    },
    "lifecycle": {
      "intervals": "must-dispose",
      "listeners": "must-dispose",
      "tools": "none",
      "shutdown": "graceful"
    },
    "tests": {
      "entry": "test/smoke.mjs",
      "command": "node test/smoke.mjs",
      "expectedExit": 0
    },
    "docs": {
      "readme": "README.md",
      "serviceDocs": {
        "agint.trajectory": "进化轨迹记录：record / get / list / export / stats（FROZEN 5）+ linkAttribution / prune / setEnabled / setSample / setRecordMode / calibration（非 FROZEN）"
      }
    },
    "changelog": "CHANGELOG.md",
    "compatSince": "0.1.0"
  }
}
