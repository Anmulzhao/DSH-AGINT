{
  "$schema": "../../docs/plugins/PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-quality-eval",
  "version": "0.3.3",
  "description": "AGINT D-QAF 评估引擎。评估目标由技能目录扫描枚举（0.3.3，同 curator 多根口径）；Sprint 12 A1 影子订阅 + 直连路径完整保留。代码实现在 plugins/agint-quality/agint-quality-eval/（monorepo 形式），顶层 manifest 为 plugin-check 入口，cordis 段与 monorepo 真身 manifest 保持一致。",
  "main": "../agint-quality/agint-quality-eval/lib/index.js",
  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 1,
    "stability": "experimental"
  },
  "spec": {
    "cordis": {
      "inject": [
        "timer",
        "agint.evolution",
        "agint.qualitySandbox"
      ],
      "provides": [
        "agint.qualityEvaluator"
      ],
      "events": [],
      "tools": [],
      "optionalInject": [
        "agint.eventBus.publish",
        "agint.eventBus.subscribe"
      ]
    },
    "storage": {
      "domains": [],
      "schemaVersion": 1,
      "atomic": "json"
    },
    "dependencies": {
      "agint-event-bus": ">=0.7.0"
    },
    "mountOrder": 80,
    "permissions": {
      "env": [
        "DSH_HOME",
        "AGINT_HOME"
      ],
      "fs": [
        "read:storages"
      ],
      "network": [],
      "shell": false
    },
    "lifecycle": {
      "intervals": "must-dispose",
      "listeners": "must-dispose",
      "tools": "none",
      "shutdown": "graceful"
    },
    "tests": {
      "entry": "../agint-quality/agint-quality-eval/test/smoke.mjs",
      "command": "node ../agint-quality/agint-quality-eval/test/smoke.mjs",
      "expectedExit": 0
    },
    "docs": {
      "readme": "../agint-quality/agint-quality-eval/README.md",
      "serviceDocs": {
        "agint.qualityEvaluator": "QualityEvaluatorIface.evaluate(target) — 7 维评分 + 一票否决 + 反自评；Sprint 12 起 score() 出口 publish evolution.evaluated"
      }
    },
    "changelog": "../agint-quality/agint-quality-eval/CHANGELOG.md",
    "compatSince": "0.2.0"
  }
}
