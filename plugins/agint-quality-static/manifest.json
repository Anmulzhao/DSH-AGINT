{
  "$schema": "../../docs/plugins/PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-quality-static",
  "version": "0.6.3",
  "description": "插件代码级静态检查独立 Cordis 插件（4 族：dependency-audit / storage-boundary / env-access / contract-reference）。Sprint 10 #4 收口：与 Prompt SDK 的模板级 static-check 形成双轨。",
  "main": "lib/index.js",

  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 1,
    "stability": "experimental"
  },

  "cordis": {
    "inject": ["storageDomain"],
    "provides": ["agint.qualityStatic"],
    "events": [],
    "tools": [],
    "optionalInject": []
  },

  "storage": {
    "domains": ["agint_static_rules"],
    "schemaVersion": 1,
    "atomic": "json"
  },

  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0",
    "zod": "^3.0.0"
  },
  "mountOrder": 36,

  "permissions": {
    "env": ["DSH_HOME", "AGINT_HOME"],
    "fs": ["read:plugins"],
    "network": [],
    "shell": false
  },

  "lifecycle": {
    "intervals": "none",
    "listeners": "none",
    "tools": "none",
    "shutdown": "graceful"
  },

  "tests": {
    "entry": "test/static-smoke.test.mjs",
    "command": "node --test test/static-smoke.test.mjs",
    "expectedExit": 0
  },

  "docs": {
    "readme": "README.md",
    "serviceDocs": {
      "agint.qualityStatic": "插件代码级静态检查（4 族：依赖白名单 / 存储越权 / env 访问 / 契约引用）。提供 checkPlugin / checkAll / listFamilies / addAllowlistEntry。"
    }
  },

  "changelog": "CHANGELOG.md",
  "compatSince": "0.6.3"
}