{
  "$schema": "../../../docs/plugins/PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-quality-eval",
  "version": "0.3.3",
  "description": "D-QAF 评估引擎 v0.3：Sprint 12 / A2 加 evolution.evaluated 边事件发布（per Sprint12 设计稿 §A3，唯一 sync 门禁边的发布方）。0.3.3 修注入声明与运行时一致：skills 目标改目录扫描枚举。",
  "main": "lib/index.js",
  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 2,
    "stability": "experimental"
  },
  "spec": {
    "cordis": {
      "inject": ["timer", "agint.evolution", "agint.qualitySandbox"],
      "optionalInject": ["agint.eventBus.publish", "agint.eventBus.subscribe"],
      "provides": ["agint.qualityEvaluator"],
      "events": [],
      "tools": []
    },
    "storage": {
      "domains": [],
      "schemaVersion": 0,
      "atomic": "none"
    },
    "dependencies": {
      "agint-quality-contract": ">=0.2.0",
      "agint-evolution-memory": ">=0.1.0",
      "agint-event-bus": ">=0.7.0"
    },
    "mountOrder": 50,
    "permissions": {
      "env": [],
      "fs": ["read:storages"],
      "network": [],
      "shell": false
    },
    "lifecycle": {
      "intervals": "none",
      "listeners": "none",
      "tools": "always",
      "shutdown": "graceful"
    },
    "tests": {
      "entry": "test/smoke.mjs",
      "command": "node test/smoke.mjs",
      "expectedExit": 0
    },
    "docs": {
      "readme": "README.md",
      "serviceDocs": {
        "agint.qualityEvaluator": "QualityEvaluatorIface.evaluate(target) — 7 维评分 + 一票否决 + 反自评；Sprint 12 起 score() 出口 publish evolution.evaluated"
      }
    },
    "changelog": "CHANGELOG.md",
    "compatSince": "0.2.0"
  }
}
