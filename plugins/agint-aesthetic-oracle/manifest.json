{
  "$schema": "../../docs/plugins/PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-aesthetic-oracle",
  "version": "0.4.2",
  "description": "美的神谕层：agint-metrics 之上的薄评论员（方案 C）。只消费 summary() 读仪表，评分纯函数 + 美之三问下判断，三档 cron 广播按节奏开口。v0.4.0 新增 §8.1 LLM 增强档（L1 措辞/L2 深挖/L3 提案润色），评分链路永久零 LLM；kill-switch AGINT_AESTHETIC_ORACLE_LLM=off/l1/l1l2/all（默认 all）；降级不阻断广播。v0.4.1 §4 真实关：Q3 建议必须绑定真实 lint 证据（wiki 矛盾/孤儿清单透传），查不到就输出「本日无可执行建议」，不编造建议。v0.4.2 L1 措辞增强超时 10s→60s：daily 实测 wall 10.78s/11.09s 连续越线降级，与 L2/L3 及 dream 的 60s 对齐。",
  "main": "lib/index.js",
  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 0,
    "stability": "experimental"
  },
  "spec": {
    "cordis": {
      "inject": [
        "storageDomain"
      ],
      "provides": [
        "agint.aestheticOracle"
      ],
      "consumes": [
        "agint.metrics",
        "agint.evolution",
        "agint.eventBus.publish",
        "agint.evolve"
      ],
      "events": [
        "oracle.daily",
        "oracle.weekly",
        "oracle.monthly",
        "oracle.alert"
      ],
      "subscriptions": [
        "oracle.daily",
        "oracle.weekly",
        "oracle.monthly",
        "oracle.alert"
      ],
      "tools": []
    },
    "storage": {
      "domains": [
        "agint_aesthetic_oracle"
      ],
      "atomic": "none"
    },
    "dependencies": {},
    "softDependencies": {
      "agint-metrics": ">=1.1.0",
      "agint-evolution-memory": ">=0.6.4",
      "agint-event-bus": ">=0.7.0",
      "agint-evolve": ">=0.1.0"
    },
    "mountOrder": 62,
    "permissions": {
      "env": [
        "AGINT_AESTHETIC_ORACLE",
        "AGINT_AESTHETIC_ORACLE_LLM"
      ],
      "fs": [],
      "network": [],
      "shell": false
    },
    "lifecycle": {
      "intervals": "none（三档广播由 agint-cron 驱动：oracle-daily/weekly/monthly）",
      "listeners": "none",
      "tools": "none",
      "shutdown": "graceful"
    },
    "tests": {
      "entry": "test/oracle.test.js",
      "command": "node --test",
      "expectedExit": 0
    },
    "docs": {
      "readme": "README.md",
      "serviceDocs": {
        "agint.aestheticOracle": "美的神谕层：runBroadcast(kind) 单次广播 / runScheduled(kind) 调度入口（重试+连续失败记账）/ alert(reason) 告警出口 / pause-resume（oracle_pause 语义）/ getState / status / history / cards()（dashboard 卡片快照，订阅 oracle.* 落 oracle_cards 表）"
      }
    },
    "changelog": "CHANGELOG.md",
    "design": "D:/DSH/project源码/DSH-AGINT.wiki/agint-aesthetic-oracle.md",
    "compatSince": "0.1.0"
  }
}
