{
  "$schema": "../../docs/plugins/PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-verify-tools",
  "version": "0.1.0",
  "description": "host 平面：把 AGINT 的验证入口（agint.cron / agint.selfModel.*）注册为全局工具。任何 preset 的会话都能手动触发 cron job 与刷新能力画像，不必等一个 cron 周期。",
  "main": "lib/index.js",
  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 1,
    "stability": "experimental"
  },
  "spec": {
    "cordis": {
      "inject": [
        "tools"
      ],
      "provides": [],
      "events": [],
      "tools": [
        "cron_list",
        "cron_run_now",
        "cron_health",
        "selfModel_snapshot",
        "selfModel_update",
        "selfModel_calibrate",
        "selfModel_stats",
        "selfModel_inspectSummary"
      ]
    },
    "storage": {
      "domains": [],
      "schemaVersion": 0,
      "atomic": "none"
    },
    "dependencies": {},
    "mountOrder": 6,
    "permissions": {
      "env": [],
      "fs": [],
      "network": [],
      "shell": false
    },
    "lifecycle": {
      "intervals": "none",
      "listeners": "none",
      "tools": "always",
      "shutdown": "graceful"
    },
    "tests": {
      "entry": "test/register.test.mjs",
      "command": "node --test test/register.test.mjs",
      "expectedExit": 0
    },
    "docs": {
      "readme": "README.md",
      "serviceDocs": {}
    },
    "changelog": "CHANGELOG.md",
    "compatSince": "0.1.0"
  }
}
