{
  "$schema": "../../docs/plugins/PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-input-gateway",
  "version": "0.1.4",
  "description": "AGINT 多源输入网关 v0.1.0（P0）：统一接入 5 类信息 Channel（人类意图/系统自观测/外部世界/对抗挑战/跨Agent），经归一化、去重、过滤、配额、路由后发布到 eventBus。P0 交付：Gateway 核心框架（scheduler/normalizer/filter/router/quota/observability/security）+ C2 系统自观测 Channel（toolStats异常/metrics退化/规则高频命中/压缩丢失/session完整性）。复用 eventBus 做传输、cron 做调度、metrics 做可观测、rules 做安全门禁，不引入新架构层。",
  "main": "lib/index.js",
  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 1,
    "stability": "experimental"
  },
  "spec": {
    "cordis": {
      "inject": [
        "storageDomain"
      ],
      "optionalInject": [
        "agint.eventBus",
        "agint.compressGuard"
      ],
      "provides": [
        "agint.inputGateway"
      ],
      "events": [],
      "tools": [
        "input_gateway_status",
        "input_gateway_channel_status",
        "input_gateway_force_fetch",
        "input_gateway_set_quota",
        "input_gateway_channel_enable",
        "input_gateway_channel_disable"
      ]
    },
    "storage": {
      "domains": [
        "agint_input_gateway"
      ],
      "schemaVersion": 1,
      "atomic": "json"
    },
    "dependencies": {
      "agint-event-bus": ">=0.7.0",
      "@deepseek-ai/dsh-storage-domain": ">=0.1.0"
    },
    "mountOrder": 35,
    "permissions": {
      "env": [
        "DSH_HOME"
      ],
      "fs": [
        "read:storages",
        "write:storages"
      ],
      "network": [],
      "shell": false
    },
    "lifecycle": {
      "intervals": "must-dispose",
      "listeners": "must-dispose",
      "tools": "must-dispose",
      "shutdown": "graceful"
    },
    "tests": {
      "entry": "test/smoke.mjs",
      "command": "node --test \"test/*.test.mjs\" test/smoke.mjs",
      "expectedExit": 0
    },
    "docs": {
      "readme": "README.md",
      "serviceDocs": {
        "agint.inputGateway": "多源输入网关：registerChannel/fetchAll/getStatus/getChannelStatus/setQuota/setChannelEnabled/forceFetch。Channel 产出 InputSignal，Gateway 归一化为 eventBus envelope 发布。"
      }
    },
    "changelog": "CHANGELOG.md",
    "compatSince": "0.1.0"
  }
}
