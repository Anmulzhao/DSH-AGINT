{
  "$schema": "../../docs/plugins/PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-quality-sandbox",
  "version": "0.6.3",
  "description": "D-QAF Phase 2 动态沙箱独立 Cordis 插件：verify/explore 双模式 + seccomp/SBPL syscall 白名单 profile 注入。Sprint 10 #2 + #3 收口：从 agint-quality 基座剥离。",
  "main": "lib/index.js",

  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 0,
    "stability": "stable"
  },

  "cordis": {
    "inject": ["sandbox"],
    "provides": ["agint.qualitySandbox"],
    "events": [],
    "tools": [],
    "optionalInject": ["agint.evolution", "agint.eventBus"]
  },

  "servicesOptional": {
    "agint.eventBus.sandboxAudit": "audit-only consumer for sandbox.passed/sandbox.failed (T1 shadow); declared by manifest but not registered by lib (registrar: agint-quality-policy)"
  },

  "storage": {
    "domains": [],
    "schemaVersion": 1,
    "atomic": "json"
  },

  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0",
    "agint-event-bus": ">=0.7.0",
    "zod": "^3.0.0"
  },
  "mountOrder": 35,

  "bpfProfile": {
    "verify": "profiles/sandbox-seccomp-verify.json",
    "explore": "profiles/sandbox-seccomp-explore.json"
  },
  "sbplProfile": {
    "verify": "profiles/sandbox-sbpl-verify.sb",
    "explore": "profiles/sandbox-sbpl-explore.sb"
  },

  "permissions": {
    "env": ["DSH_HOME", "AGINT_HOME"],
    "fs": ["read:plugins/agint-quality-sandbox"],
    "network": ["loopback"],
    "shell": false
  },

  "lifecycle": {
    "intervals": "none",
    "listeners": "none",
    "tools": "none",
    "shutdown": "graceful"
  },

  "tests": {
    "entry": "test/dual-mode.test.mjs",
    "command": "node --test test/dual-mode.test.mjs",
    "expectedExit": 0
  },

  "docs": {
    "readme": "README.md",
    "serviceDocs": {
      "agint.qualitySandbox": "verify/explore 双模式沙箱执行 + syscall 白名单 profile 注入 + 降级路径可证。提供 runVerify / runExplore / resolveProfile / routeForMutation / runSmoke（向后兼容 v0.3）/ backendHealth。"
    }
  },

  "changelog": "CHANGELOG.md",
  "compatSince": "0.6.3"
}