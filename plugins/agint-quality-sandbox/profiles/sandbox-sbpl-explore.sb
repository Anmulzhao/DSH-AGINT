; agint.sprint10 -- sandbox-sbpl-explore.sb (v0.6.3 占位骨架)
; 子任务 #3 必填：填具体 SBPL 规则 + 限 /usr/bin/node execve.
(version 1)
(deny default)

; 允许的 syscall（最小集）
(allow syscall-read)
(allow syscall-write)
(allow syscall-open)
(allow syscall-close)
(allow syscall-exit)
(allow syscall-mmap)
(allow syscall-mprotect)
(allow syscall-munmap)
(allow syscall-rt_sigaction)
(allow syscall-ioctl)
(allow syscall-getpid)
(allow syscall-getuid)
(allow syscall-geteuid)
(allow syscall-futex)

; explore 模式放宽：允许 execve 但限白名单
(allow syscall-execve)
(allow process-exec
  (path-argument "/usr/bin/node")
  (path-argument "/usr/bin/git")
)
(deny process-exec
  (path-argument "/bin/sh")
  (path-argument "/bin/bash")
  (path-argument "/bin/zsh")
  (path-argument "/bin/fish")
  (path-argument "/bin/dash")
)

; 仍禁：fork（防止 sandbox 内再起 sandbox）
(deny syscall-fork)
(deny syscall-vfork)
(deny syscall-ptrace)

; 网络全隔离（不变）
(deny network*)
(deny network-inbound)
(deny network-outbound)

; 文件系统：workspace 可写
(allow file-write* (subpath "/workspace"))
(deny file-write* (subpath "/etc"))
(deny file-write* (subpath "/usr/bin"))
(deny file-write* (subpath "/bin"))

; meta
(_meta
  (platform "darwin")
  (mode "explore")
  (description "Sprint 10 #3 subagent 必填.")
  (sprint "10")
  (version "0.6.3"))