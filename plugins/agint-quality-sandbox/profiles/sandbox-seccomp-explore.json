{
  "_meta": {
    "platform": "linux",
    "mode": "explore",
    "description": "Sprint 10 #3 subagent 必填。在 verify 基础上放宽 execve（限白名单二进制）。",
    "sprint": "10",
    "version": "0.6.3",
    "inheritsFrom": "sandbox-seccomp-verify.json"
  },
  "defaultAction": "SCMP_ACT_KILL_PROCESS",
  "syscallAllow": [
    "read", "write", "open", "openat", "close", "exit", "exit_group",
    "brk", "mmap", "mprotect", "munmap", "rt_sigaction", "rt_sigreturn",
    "fstat", "stat", "lstat", "getpid", "getuid", "getgid", "geteuid", "getegid",
    "futex", "set_tid_address", "set_robust_head", "clock_gettime", "getrandom",
    "ioctl",
    "execve", "execveat"
  ],
  "execveAllowlist": ["/usr/bin/node", "/usr/bin/git"],
  "execveDeny": ["/bin/bash", "/bin/sh", "/bin/zsh", "/bin/fish", "/bin/dash"],
  "syscallDeny": [
    "fork", "vfork", "clone",
    "ptrace",
    "socket", "connect", "bind", "listen", "accept", "sendto", "recvfrom",
    "kill",
    "mount", "umount", "reboot", "swapon", "swapoff",
    "init_module", "delete_module"
  ],
  "arch": ["SCMP_ARCH_X86_64", "SCMP_ARCH_AARCH64"],
  "note": "execve 限 node/git. 三道独立约束（网络隔离 + workspace + 白名单二进制）子任务 #3 用 BPF 程序 + user-mode argv[0] 拦截实现."
}