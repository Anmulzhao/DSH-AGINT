{
  "name": "hello-prompt",
  "version": "0.1.0",
  "description": "Minimal hello prompt demonstrating SDK contract.",
  "kind": "system",
  "variables": [
    {
      "name": "user",
      "description": "User-side variables",
      "required": true,
      "type": "string"
    },
    {
      "name": "product",
      "description": "Product-side variables",
      "required": true,
      "type": "string"
    }
  ],
  "regressionTests": [
