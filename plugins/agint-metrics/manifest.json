{
  "$schema": "../../docs/plugins/PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-metrics",
  "version": "1.1.2",
  "description": "AGINT evolution metrics host 服务。代码实现在 plugins/agint-metrics/lib/（真实代码），顶层 manifest 为 plugin-check 入口。Sprint 12 A5：与 agint-quality-report 同源同步接入 policy.* 影子计数（结构对齐）。v1.1.0（2026-09-27 美的神谕层 Day 0 / 方案 C）：METRIC_DEFS +4 原子 key（autocreate.candidatesRejected / skills.totalBytes / evolution.logCount7d / logCount30d，计算块拆 metrics-ext.js）；三个既有 key 的 meta 增补派生所需原子事实（rulesTotal / wiki 总页数 / memory 无证据清单 + Σconf×compliance），value 一律不动。",
  "main": "./lib/index.js",
  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 1,
    "stability": "experimental"
  },
  "spec": {
    "cordis": {
      "inject": [],
      "provides": [
        "agint.metrics"
      ],
      "events": [],
      "tools": [],
      "optionalInject": [
        "agint.eventBus",
        "agint.cron",
        "agint.rules",
        "agint.wiki",
        "agint.memory",
        "agint.skillAutocreate",
        "agint.evolution"
      ]
    },
    "storage": {
      "domains": [
        "agint_metrics"
      ],
      "schemaVersion": 1,
      "atomic": "json"
    },
    "dependencies": {
      "agint-event-bus": ">=0.7.0"
    },
    "mountOrder": 82,
    "permissions": {
      "env": [
        "DSH_HOME",
        "AGINT_HOME"
      ],
      "fs": [
        "read:storages",
        "write:storages"
      ],
      "network": [],
      "shell": false
    },
    "lifecycle": {
      "intervals": "must-dispose",
      "listeners": "must-dispose",
      "tools": "none",
      "shutdown": "graceful"
    },
    "tests": {
      "entry": "./test/smoke.mjs",
      "command": "node ./test/smoke.mjs",
      "expectedExit": 0
    },
    "docs": {
      "readme": "./README.md",
      "serviceDocs": {
        "agint.metrics": "evolution metrics host service (kv time series + collect/summary + policy 影子计数)"
      }
    },
    "changelog": "./CHANGELOG.md",
    "compatSince": "1.0.0"
  }
}
