{
  "$schema": "../../docs/plugins/PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-evolution-memory",
  "version": "0.6.12",
  "description": "物理隔离的进化记忆存储域。Sprint 10 v0.6.4 #7 加 EvolutionLogBuffer（异步批量写入 + flush 3 策略 + 退出钩子 + 读时合并视图 + buffer-lost 兜底）。v0.6.7 修影子订阅写入契约（decision/targetKind 越枚举导致 evolution_log 恒 0）。v0.6.8 加 Phase 1 交付物 3：evolution_ledger 防篡改链（entryHash/parentHash + 8 条批根 + roll-up 根链 + Merkle proof）、Git 外部锚定（只 commit 不 push）、历史条目重建。",
  "main": "lib/index.js",
  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 0,
    "stability": "stable"
  },
  "spec": {
    "cordis": {
      "inject": [
        "storageDomain"
      ],
      "provides": [
        "agint.evolution"
      ],
      "events": [],
      "tools": [],
      "optionalInject": [
        "agint.eventBus"
      ]
    },
    "storage": {
      "domains": [
        "agint_evolution"
      ],
      "schemaVersion": 1,
      "atomic": "json"
    },
    "dependencies": {
      "@deepseek-ai/dsh-storage-domain": ">=0.1.0",
      "zod": "^3.0.0",
      "agint-event-bus": ">=0.7.0"
    },
    "mountOrder": 20,
    "permissions": {
      "env": [
        "DSH_HOME",
        "AGINT_HOME"
      ],
      "fs": [
        "read:plugins/agint-evolution-memory",
        "read:storages",
        "write:storages",
        "write:docs/evolution-ledger-anchor.md"
      ],
      "network": [],
      "shell": [
        "git"
      ]
    },
    "lifecycle": {
      "intervals": "none",
      "listeners": "none",
      "tools": "none",
      "shutdown": "graceful"
    },
    "tests": {
      "entry": "test/smoke.mjs",
      "command": "node test/smoke.mjs",
      "expectedExit": 0
    },
    "docs": {
      "readme": "README.md",
      "serviceDocs": {
        "agint.evolution": "进化记忆读写 + L1-L4 衰减 + Sprint 10 v0.6.4 #7 EvolutionLogBuffer 异步批量（logPhase4Buffered / readLogRangeMerged / flushLogBufferNow）。"
      }
    },
    "changelog": "CHANGELOG.md",
    "compatSince": "0.3.0"
  }
}
