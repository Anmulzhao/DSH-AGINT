          { "decision": "AUTO_DEPLOY", "score": 95, "ts": "2026-08-12T00:00:00Z" },
          { "decision": "PENDING_REVIEW", "score": 80, "ts": "2026-08-15T00:00:00Z" }
        ],
        "k": 5,
        "_note": "5 个有 variance → clean (3 unique decisions)"
      }
    ],
    "expected": [
      {
        "kind": "rejection-uniformity-clean"
      }
    ]
  },
  {
