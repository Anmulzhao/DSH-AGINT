[
  {
    "scenario": "harmony-detect-rejection-uniformity",
    "plugin": "agint-quality-policy",
    "input": [
      {
        "service": "falseHarmonyDetector",
        "action": "detectRejectionUniformity",
        "history": [
          { "decision": "REJECT", "score": 0, "ts": "2026-08-01T00:00:00Z" },
          { "decision": "REJECT", "score": 0, "ts": "2026-08-05T00:00:00Z" },
          { "decision": "REJECT", "score": 0, "ts": "2026-08-10T00:00:00Z" },
          { "decision": "REJECT", "score": 0, "ts": "2026-08-12T00:00:00Z" },
          { "decision": "REJECT", "score": 0, "ts": "2026-08-15T00:00:00Z" }
        ],
        "k": 5,
        "_note": "5 个连续 REJECT,无 variance → 触发反和谐 'rejection-uniformity'"
      }
    ],
    "expected": [
      {
        "kind": "rejection-uniformity-detected"
      }
    ]
  },
  {
