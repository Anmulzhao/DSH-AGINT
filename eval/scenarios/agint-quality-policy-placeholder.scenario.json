[
  {
    "scenario": "policy-decide-empty-results-abstain",
    "plugin": "agint-quality-policy",
    "input": [
      {
        "service": "qualityPolicy",
        "action": "decide",
        "results": [],
        "_note": "空 results → ABSTAIN (v0.3 占位逻辑)"
      }
    ],
    "expected": [
      {
        "kind": "decision-shape",
        "decision": "ABSTAIN",
        "reasonContains": "empty-results"
      }
    ]
  },
  {
    "scenario": "policy-decide-safety-veto-rejects",
    "plugin": "agint-quality-policy",
    "input": [
      {
        "service": "qualityPolicy",
        "action": "decide",
        "results": [
          {
            "targetId": "broken-plugin",
            "kind": "plugin",
            "dimensions": [
              {
                "key": "safety",
                "score": { "score": 0 },
                "veto": true
              }
            ],
            "findings": [
              { "severity": "blocker", "message": "sandbox-failed:plugin-not-found" }
            ]
          }
        ],
        "_note": "safety.veto=true → REJECT, perTarget reason='safety-veto'"
      }
    ],
    "expected": [
      {
        "kind": "decision-shape",
        "decision": "REJECT",
        "perTargetDecisions": ["REJECT"],
        "perTargetReasons": ["safety-veto"]
      }
    ]
  },
  {
    "scenario": "policy-decide-clean-results-pending",
    "plugin": "agint-quality-policy",
    "input": [
      {
        "service": "qualityPolicy",
        "action": "decide",
        "results": [
          {
            "targetId": "good-plugin",
            "kind": "plugin",
            "dimensions": [
              { "key": "safety", "score": { "score": 1 }, "veto": false },
              { "key": "trust", "score": { "score": 0.8 } }
            ],
            "findings": []
          }
        ],
        "_note": "safety 不 veto + 无 blocker finding → PENDING_REVIEW (v0.3 占位)"
      }
    ],
    "expected": [
      {
        "kind": "decision-shape",
        "decision": "PENDING_REVIEW",
        "perTargetDecisions": ["PENDING_REVIEW"],
        "reasonContains": "policy-pending-sprint-4"
      }
    ]
  },
  {
    "scenario": "policy-reject-triggers-evo-addFailure",
    "plugin": "agint-quality-policy",
    "input": [
      {
        "service": "qualityPolicy",
        "action": "decideWithEvo",
        "results": [
          {
            "targetId": "broken-plugin-x",
            "kind": "plugin",
            "dimensions": [{ "key": "safety", "score": { "score": 0 }, "veto": true }],
            "findings": [{ "severity": "blocker", "message": "test" }]
          }
        ],
        "_note": "REJECT → 自动 evo.addFailure(pattern='policy-reject:REJECT')"
      }
    ],
    "expected": [
      {
        "kind": "evo-received-addFailure",
        "pattern": "policy-reject:REJECT",
        "category": "integration",
        "severity": "high"
      }
    ]
  },
  {
    "scenario": "policy-pending-does-not-trigger-addFailure",
    "plugin": "agint-quality-policy",
    "input": [
      {
        "service": "qualityPolicy",
        "action": "decideWithEvo",
        "results": [
          {
            "targetId": "good-plugin-y",
            "kind": "plugin",
            "dimensions": [{ "key": "safety", "score": { "score": 1 }, "veto": false }],
            "findings": []
          }
        ],
        "_note": "PENDING_REVIEW 不应触发 evo.addFailure"
      }
    ],
    "expected": [
      {
        "kind": "evo-received-no-addFailure",
        "failPatternsCount": 0
      }
    ]
  },
  {
    "scenario": "policy-writes-evolution-log",
    "plugin": "agint-quality-policy",
    "input": [
      {
        "service": "qualityPolicy",
        "action": "decideWithEvo",
        "results": [
          {
            "targetId": "any-plugin-z",
            "kind": "plugin",
            "dimensions": [{ "key": "safety", "score": { "score": 0.8 }, "veto": false }],
            "findings": []
          }
        ],
        "_note": "任意 decision → evo.logPhase4 写 evolution_log (PENDING_REVIEW 也写)"
