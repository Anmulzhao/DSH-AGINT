{
  "$schema": "../../PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-evolution-memory",
  "version": "0.1.0",
  "description": "AGINT 跨代记忆（success-templates / failure-patterns），与 agint-memory 区分。独占 agint_evolution domain。",
  "main": "lib/index.js",
  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 1,
    "stability": "experimental"
  },
  "spec": {
    "cordis": {
      "inject": ["storageDomain"],
      "provides": ["agint.evolution"],
      "events": [],
      "tools": []
    },
    "storage": {
      "domains": ["agint_evolution"],
      "schemaVersion": 1,
      "atomic": "json"
    },
    "dependencies": {
      "agint-memory": ">=0.1.0"
    },
    "mountOrder": 12,
    "permissions": {
      "env": ["DSH_HOME"],
      "fs": ["read:storages", "write:storages"],
      "network": [],
      "shell": false
    },
    "lifecycle": {
      "intervals": "none",
      "listeners": "none",
      "tools": "always",
      "shutdown": "graceful"
    },
    "tests": {
      "entry": "test/smoke.mjs",
      "command": "node test/smoke.mjs",
      "expectedExit": 0
    },
    "docs": {
      "readme": "README.md",
      "serviceDocs": {
        "agint.evolution": "success-templates + failure-patterns，dream deep 阶段评分参考"
      }
    },
    "changelog": "CHANGELOG.md",
    "compatSince": "0.1.0"
  }
}