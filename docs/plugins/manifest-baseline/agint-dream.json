{
  "$schema": "../../PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-dream",
  "version": "0.1.0",
  "description": "夜间梦境 sweep（light→REM→deep 三阶段）。会话日志 → 候选 → 6 维评分 → 门槛 → 提升进 agint.memory。梦境日记写 <root>/YYYY-MM-DD.md。",
  "main": "lib/index.js",
  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 1,
    "stability": "beta"
  },
  "spec": {
    "cordis": {
      "inject": ["agint.memory", "agint.metrics"],
      "provides": ["agint.dream"],
      "events": [],
      "tools": ["dream_status", "dream_diary", "dream_run_now"]
    },
    "storage": {
      "domains": [],
      "schemaVersion": 0,
      "atomic": "files"
    },
    "dependencies": {
      "agint-memory": ">=0.1.0",
      "agint-metrics": ">=0.1.0"
    },
    "mountOrder": 30,
    "permissions": {
      "env": ["AGINT_HOME", "DSH_HOME"],
      "fs": ["read:sessions", "write:dreams"],
      "network": [],
      "shell": false
    },
    "lifecycle": {
      "intervals": "none",
      "listeners": "none",
      "tools": "always",
      "shutdown": "graceful"
    },
    "tests": {
      "entry": "test/smoke.mjs",
      "command": "node test/smoke.mjs",
      "expectedExit": 0
    },
    "docs": {
      "readme": "README.md",
      "serviceDocs": {
        "agint.dream": "离线梦境 sweep：light（heuristic 提取）→REM（6 维评分）→deep（30 天恢复通道）"
      }
    },
    "changelog": "CHANGELOG.md",
    "compatSince": "0.1.0"
  }
}