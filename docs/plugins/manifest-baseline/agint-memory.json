{
  "$schema": "../../PLUGIN-SPEC.md#manifest-schema",
  "name": "agint-memory",
  "version": "0.1.0",
  "description": "长/短期记忆读写 + L1-L4 四级衰减扫描。独占 agint storage domain。",
  "main": "lib/index.js",
  "agint": {
    "kind": "host",
    "owner": "anmul",
    "tier": 0,
    "stability": "stable"
  },
  "spec": {
    "cordis": {
      "inject": ["storageDomain"],
      "provides": ["agint.memory"],
      "events": [],
      "tools": ["memory_search", "memory_write", "memory_read", "memory_stats", "memory_forget_scan"]
    },
    "storage": {
      "domains": ["agint"],
      "schemaVersion": 1,
      "atomic": "json"
    },
    "dependencies": {
      "cordis": ">=0.1.0",
      "zod": "^3.0.0"
    },
    "mountOrder": 10,
    "permissions": {
      "env": ["AGINT_HOME", "DSH_HOME"],
      "fs": ["read:wiki", "write:storages"],
      "network": [],
      "shell": false
    },
    "lifecycle": {
      "intervals": "none",
      "listeners": "none",
      "tools": "always",
      "shutdown": "graceful"
    },
    "tests": {
      "entry": "test/smoke.mjs",
      "command": "node test/smoke.mjs",
      "expectedExit": 0
    },
    "docs": {
      "readme": "README.md",
      "serviceDocs": {
        "agint.memory": "长/短期记忆读写 + 四级衰减扫描"
      }
    },
    "changelog": "CHANGELOG.md",
    "compatSince": "0.1.0"
  }
}