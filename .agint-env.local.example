# .agint-env.local.example — 机器级环境配置模板（Phase -1.4）
#
# 用法：复制为 .agint-env.local（已 gitignore），按本机实际路径填值。
#   cp .agint-env.local.example .agint-env.local
# 校验：node bin/validate-env-config.mjs --strict
#
# 优先级：process.env > .agint-env.local > .env。本机 override 只写这份，不入库，
# 因此两台机器（Linux / Windows）互不覆盖。仓库里的默认值一律留空 / 相对。

# dsh 运行数据基目录（storages 在其下）。必填。
#   Windows 示例：DSH_HOME=C:\Users\<you>\.dsh
#   Linux   示例：DSH_HOME=/home/<you>/.dsh
DSH_HOME=

# AGINT 仓根（不是数据目录）。留空则脚本按仓根自动推导。
AGINT_HOME=

# wiki 根。
DSH_WIKI_ROOT=

# DSH-AGINT checkout 根 —— 喂给 C3 external-git 的 dsh-agint 槽位。
# 不配则 C3 空转（该 channel 当前未启用，无副作用）。
DSH_PROJECT_ROOT=

# 追加要跟踪的 git 仓库，格式 `id=path;path2`（; 或 , 分隔）。
# 示例：DSH_INPUT_GATEWAY_REPOS=dsh=/path/to/dsh;openclaw=/path/to/openclaw
DSH_INPUT_GATEWAY_REPOS=
